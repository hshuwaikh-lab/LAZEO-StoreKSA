generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              Int      @id @default(autoincrement())
  email           String   @unique
  username        String
  password        String
  role            String   @default("customer") // "customer" or "admin"
  phone           String?
  address         String?
  isActive        Boolean  @default(true)
  receiveWhatsApp Boolean  @default(true)
  provider        String?
  providerId      String?
  createdAt       DateTime @default(now())
  
  orders          Order[]
  customOrders    CustomOrder[]
  savedLocations  UserSavedLocation[]
}

model UserSavedLocation {
  id              Int      @id @default(autoincrement())
  userId          Int
  label           String
  nationalAddress String?
  city            String?
  postalCode      String?
  lat             Float?
  lng             Float?
  isDefault       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Order {
  id             Int      @id @default(autoincrement())
  userId         Int
  items          String   // JSON string of items
  totalAmount    Float
  couponCode     String?
  discountAmount Float    @default(0)
  status         String   @default("pending") // pending, paid, shipped, delivered, rejected
  receiptUrl     String?
  receiptText    String?
  bankId         Int?
  shippingProvider String?
  receiverName   String?
  receiverPhone  String?
  receiverCity   String?
  receiverDistrict String?
  receiverStreet String?
  receiverNearbyLandmark String?
  invoicePrinted Boolean  @default(false)
  invoiceNumber  String?
  createdAt      DateTime @default(now())

  user           User         @relation(fields: [userId], references: [id])
  bank           BankAccount? @relation(fields: [bankId], references: [id])
}

model Coupon {
  id             Int      @id @default(autoincrement())
  code           String   @unique
  discountType   String   // percent | fixed
  discountValue  Float
  minOrderAmount Float?
  maxDiscount    Float?
  expiresAt      DateTime?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model CustomOrder {
  id            Int      @id @default(autoincrement())
  userId        Int
  material      String
  details       String
  attachmentUrl String?
  attachmentText String?
  status        String   @default("pending") // pending, priced, accepted, rejected
  priceQuote    Float?
  createdAt     DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id])
}

model ShippingMethod {
  id            Int      @id @default(autoincrement())
  name          String
  price         Float
  estimatedDays String
  logoUrl       String?
}

model BankAccount {
  id            Int      @id @default(autoincrement())
  bankName      String
  accountName   String
  accountNumber String
  iban          String
  logoUrl       String?
  
  orders        Order[]
}

model Product {
  id            Int      @id @default(autoincrement())
  nameAr        String
  nameEn        String
  price         Float
  offerPrice    Float?
  offerMinQuantity Int?
  offerEndsAt   DateTime?
  image         String?
  descriptionAr String
  descriptionEn String
  category      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Material {
  id        Int      @id @default(autoincrement())
  nameAr    String
  nameEn    String
  createdAt DateTime @default(now())
}

model StoreSettings {
  id             Int      @id @default(autoincrement())
  whatsappNumber String?
  whatsappToken  String?
  snapchatUrl    String?
  instagramUrl   String?
  storeNationalAddress String?
  storeLat       Float?
  storeLng       Float?
  shippingBasePrice Float?
  shippingPricePerKm Float?
  shippingMinPrice Float?
  shippingMaxPrice Float?
  shippingCarrierThreshold Float?
  shippingCarrierFixedPrice Float?
  shippingCarrierProvider String?
  updatedAt      DateTime @updatedAt
}
