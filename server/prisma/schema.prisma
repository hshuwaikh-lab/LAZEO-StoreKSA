generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(auto()) @db.ObjectId
  email           String   @unique
  username        String
  password        String
  role            String   @default("customer") // "customer" or "admin"
  phone           String?
  address         String?
  isActive        Boolean  @default(true)
  receiveWhatsApp Boolean  @default(true)
  provider        String?
  providerId      String?
  createdAt       DateTime @default(now())
  
  orders          Order[]
  customOrders    CustomOrder[]
}

model Order {
  id             String   @id @default(auto()) @db.ObjectId
  userId         String   @db.ObjectId
  items          String   // JSON string of items
  totalAmount    Float
  status         String   @default("pending") // pending, paid, shipped, delivered, rejected
  receiptUrl     String?
  receiptText    String?
  bankId         String?  @db.ObjectId
  invoicePrinted Boolean  @default(false)
  invoiceNumber  String?
  createdAt      DateTime @default(now())

  user           User         @relation(fields: [userId], references: [id])
  bank           BankAccount? @relation(fields: [bankId], references: [id])
}

model CustomOrder {
  id            String   @id @default(auto()) @db.ObjectId
  userId        String   @db.ObjectId
  material      String
  details       String
  attachmentUrl String?
  attachmentText String?
  status        String   @default("pending") // pending, priced, accepted, rejected
  priceQuote    Float?
  createdAt     DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id])
}

model ShippingMethod {
  id            String   @id @default(auto()) @db.ObjectId
  name          String
  price         Float
  estimatedDays String
  logoUrl       String?
}

model BankAccount {
  id            String   @id @default(auto()) @db.ObjectId
  bankName      String
  accountName   String
  accountNumber String
  iban          String
  logoUrl       String?
  
  orders        Order[]
}

model Product {
  id            String   @id @default(auto()) @db.ObjectId
  nameAr        String
  nameEn        String
  price         Float
  image         String?
  descriptionAr String
  descriptionEn String
  category      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Material {
  id        String   @id @default(auto()) @db.ObjectId
  nameAr    String
  nameEn    String
  createdAt DateTime @default(now())
}

model StoreSettings {
  id             String   @id @default(auto()) @db.ObjectId
  whatsappNumber String?
  whatsappToken  String?
  snapchatUrl    String?
  instagramUrl   String?
  updatedAt      DateTime @updatedAt
}
