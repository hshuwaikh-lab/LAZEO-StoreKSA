{
  "name": "web-lazeo-storeksa",
  "private": true,
  "version": "0.0.0",
  "homepage": "https://lazeoksa.com/",
  "productName": "LAZEO Store",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:desktop": "vite build --base=./",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "node server-static.js",
    "desktop:dev": "concurrently -k \"npm:dev\" \"wait-on tcp:5173 && electron .\"",
    "desktop:start": "electron .",
    "desktop:build": "npm run build:desktop && electron-packager . \"LAZEO Desktop\" --platform=win32 --arch=x64 --out=release --overwrite --prune=true --icon=build/icon.ico",
    "desktop:installer": "npm run build:desktop && electron-builder --win nsis",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.2",
    "exceljs": "^4.4.0",
    "express": "^4.21.0",
    "html2canvas": "^1.4.1",
    "i18next": "^26.0.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.7.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^17.0.2",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.13.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "electron": "^32.3.3",
    "electron-builder": "^25.1.8",
    "electron-packager": "^17.1.2",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "gh-pages": "^5.0.0",
    "globals": "^17.4.0",
    "vite": "^8.0.1",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.lazeo.store",
    "productName": "LAZEO Store",
    "artifactName": "LAZEO Store Setup.${ext}",
    "icon": "build/icon.ico",
    "asar": true,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "sign": false,
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "perMachine": false,
      "allowElevation": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    }
  }
}
